# Never commit a real .env. Generate independent random secrets, not these examples.

# 认证与附件存储独立选择，不由服务器部署位置决定。
#   password   单用户口令（自托管默认）。多用户环境必须换掉——它把任何登录都映射到同一个 OWNER_ID。
#   cloudbase  云开发身份认证
AUTH_MODE=password
# s3：MinIO / COS / AWS S3 / R2 等兼容存储；cloudbase：CloudBase PG Storage API。
STORAGE_DRIVER=s3
# 旧安装兼容：未设置 AUTH_MODE / STORAGE_DRIVER 时，BACKEND=cloudbase
# 分别回退到 cloudbase，否则分别回退到 password / s3。新安装无需设置 BACKEND。
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:8787
OWNER_ID=owner
AUTH_PASSWORD=
JWT_SECRET=
DATABASE_URL=postgresql://drill_app:CHANGE_ME@localhost:5432/drill
POSTGRES_ADMIN_PASSWORD=
DRILL_DB_PASSWORD=
S3_ACCESS_KEY=drill-admin
S3_SECRET_KEY=
# 可选：临时凭证的 session token；临时凭证到期需由部署者更新。
S3_SESSION_TOKEN=
# 宿主直接运行时使用此地址；compose.yml 内部地址由 S3_INTERNAL_ENDPOINT 指定。
# compose.external.yml 原样读取 S3_ENDPOINT，连接你选择的外部存储。
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
# 客户端实际上传/读取的签名地址；留空则使用 S3_ENDPOINT。
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=drill
S3_REGION=us-east-1
S3_PATH_STYLE=true
# Optional, server-only. AI_BASE_URL includes provider version prefix, e.g. https://provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# ── Embedding ────────────────────────────────────────────────
# 模型推理可以独立外包；对象存储也可独立选择自托管或云服务。
# 不变式：下面这条链上的所有供应商必须提供**同一个模型**。
# 向量只在同一模型的向量空间里可比；混用不报错，只是检索会静默变差。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024
# 主供应商。硅基流动（当前免费）：https://api.siliconflow.cn/v1/embeddings
# 自建（compose semantic profile）：http://embedding:8080/embeddings
EMBEDDING_URL=
EMBEDDING_KEY=
# 备选供应商，JSON 数组。format 取 openai（默认）或 cloudflare。
# 例：[{"name":"cf","url":"https://api.cloudflare.com/client/v4/accounts/xxx/ai/run/@cf/baai/bge-m3","key":"yyy","format":"cloudflare"}]
# 主站故障时自动转移，并在 60 秒静默期内跳过它——否则每次调用都要白等一整个超时。
EMBEDDING_FALLBACKS=
EMBEDDING_TIMEOUT_MS=45000
# 换模型后必须重建索引，否则语义检索会静默返回空。
# GET /health 看当前配置；POST /search/reindex 返回里的 stale_models 非空即表示需要重建。
RELATED_THRESHOLD=0.65
WALK_JUMP_RATE=0.15
# AUTH_MODE=cloudbase 使用认证字段；STORAGE_DRIVER=cloudbase 使用存储字段。
# 两者独立，与 PostgreSQL 的部署位置无关；存储不是 classic CloudBase storage API。
CLOUDBASE_ENV_ID=
CLOUDBASE_CLIENT_ID=
CLOUDBASE_AUTH_INTROSPECT_URL=
CLOUDBASE_STORAGE_BASE=
CLOUDBASE_SERVICE_KEY=
CLOUDBASE_BUCKET=
PGSSL=require
PGSSL_VERIFY=true

# ── Drill Agent（仅服务端；不要加 VITE_ 前缀）─────────────────
# 推荐官方 Harness。原安装未设置本段时仍保留轻量 deepseek 默认，不静默降级。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# REST 主调用 / 只读子分析的模型名，与 Harness 路由名分别配置。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DRILL_AGENT_ENGINE=harness
DRILL_HARNESS_MODEL=deepseek-v4-flash
# Docker 构建时安装独立的官方 SDK；本机用 npm run agent:install-harness。
DRILL_WITH_HARNESS=true
DRILL_AGENT_MAX_TOKENS=4096
# 原生引擎最多模型步骤；Harness 桥最多允许此值 × 4 次工具调用。
DRILL_AGENT_MAX_STEPS=10
DRILL_AGENT_DAILY_RUNS=30
DRILL_AGENT_TIMEOUT_MS=180000
DRILL_AGENT_CONTEXT_CHARS=48000
# 可选联网；仍需要对话中手动开启。洞察绝不联网。
TAVILY_API_KEY=
