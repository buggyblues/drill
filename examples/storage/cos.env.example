# 先运行 node scripts/init-env.mjs，再将以下配置合并到 .env。
# 使用 infra/compose/compose.external.yml，不会创建本机 MinIO。
AUTH_MODE=password
STORAGE_DRIVER=s3
APP_ORIGIN=https://drill.honi.pro

# 替换地域、完整桶名（含 APPID）、限定到该桶的 SecretId / SecretKey。
# 这是区域端点，不在端点中重复填写桶名。SDK 根据桶名生成访问主机名。
S3_ENDPOINT=https://cos.ap-beijing.myqcloud.com
S3_PUBLIC_ENDPOINT=https://cos.ap-beijing.myqcloud.com
S3_REGION=ap-beijing
S3_BUCKET=YOUR_BUCKET-APPID
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=
S3_PATH_STYLE=false

# 私有桶，CORS 精确允许 APP_ORIGIN；PUT/GET/HEAD 及所需签名/元数据请求头。
# URL 签名后不可改 Host。自定义域名的预览与签名兼容性需单独验证。
